FROM node:22-trixie AS build
RUN apt-get update && apt-get install -y --no-install-recommends make python3 python3-jinja2 node-typescript && rm -rf /var/lib/apt/lists/*
RUN npm install -g esbuild@0.28.2
WORKDIR /app
COPY . .
RUN make build

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-jinja2 python3-requests rsync util-linux ca-certificates locales tzdata && localedef -i zh_CN -f UTF-8 zh_CN.UTF-8 && rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.source="https://github.com/ustclug/mirrors-index" org.opencontainers.image.licenses="GPL-2.0-only"
WORKDIR /app
COPY LICENSE ./LICENSE
COPY --from=build /app/dist ./dist
COPY *.py ./
COPY z-genisolist ./z-genisolist
COPY templates ./templates
COPY docker/entrypoint.sh ./docker/entrypoint.sh
ENV LANG=zh_CN.UTF-8 CONFIG_DIR=/config OUTDIR=/output CACHE_DIR=/tmp/mirrors-index-cache PYTHONDONTWRITEBYTECODE=1
USER 1000:1000
ENTRYPOINT ["sh", "/app/docker/entrypoint.sh"]
